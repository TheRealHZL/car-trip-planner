# =============================================================================
# CAR VISIT PLANNER - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# GENERAL SETTINGS
# -----------------------------------------------------------------------------
# Environment mode: development | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# FRONTEND SETTINGS
# -----------------------------------------------------------------------------
# Port for the frontend application
FRONTEND_PORT=3000

# Supabase connection (for the frontend)
# In production, use your actual domain
VITE_SUPABASE_URL=http://localhost:8000
# IMPORTANT: Copy the ANON_KEY value here (same as below)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# -----------------------------------------------------------------------------
# SUPABASE SETTINGS
# -----------------------------------------------------------------------------

# Database Configuration
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# JWT Configuration
# IMPORTANT: Generate these with the generate-keys.sh script!
# JWT Secret must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# API Keys
# IMPORTANT: Generate these with the generate-keys.sh script!
# These keys are JWT tokens signed with JWT_SECRET
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Kong API Gateway Ports
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# External URLs
# Update these for production deployment
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=

# -----------------------------------------------------------------------------
# SUPABASE AUTH SETTINGS
# -----------------------------------------------------------------------------
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# SMTP Configuration (for email authentication)
# Leave empty to use console logging in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# SUPABASE STUDIO SETTINGS (Optional)
# -----------------------------------------------------------------------------
STUDIO_PORT=3001
STUDIO_DEFAULT_ORGANIZATION=Car Visit Planner
STUDIO_DEFAULT_PROJECT=car-visit-planner

# -----------------------------------------------------------------------------
# EDGE FUNCTIONS SETTINGS
# -----------------------------------------------------------------------------
FUNCTIONS_VERIFY_JWT=false

# -----------------------------------------------------------------------------
# LOGGING & ANALYTICS
# -----------------------------------------------------------------------------
LOGFLARE_API_KEY=stub

# -----------------------------------------------------------------------------
# IMAGE PROXY SETTINGS
# -----------------------------------------------------------------------------
IMGPROXY_ENABLE_WEBP_DETECTION=true

# -----------------------------------------------------------------------------
# PANGOLIN TUNNEL (NEWT)
# -----------------------------------------------------------------------------
# Tunnel service for exposing the application externally
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=your-newt-id
NEWT_SECRET=your-newt-secret

# IMPORTANT: In Pangolin Web UI, configure the target as:
#   Target Host: frontend
#   Target Port: 80
# NOT localhost:3000! The frontend runs on port 80 inside Docker.

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production:
# 1. Generate new JWT_SECRET, ANON_KEY, and SERVICE_ROLE_KEY
# 2. Set strong POSTGRES_PASSWORD
# 3. Update API_EXTERNAL_URL and SITE_URL to your domain
# 4. Configure SMTP for email authentication
# 5. Set ENABLE_EMAIL_AUTOCONFIRM=false
# 6. Set FUNCTIONS_VERIFY_JWT=true
# 7. Consider disabling STUDIO in production
# =============================================================================
